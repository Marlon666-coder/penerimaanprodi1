{
  "name": "nexus-admission",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS ADMISSION — futuristic study program admission system (Node.js + SQLite + ES-module SPA)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
