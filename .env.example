# Copy to .env and adjust. NEVER commit the real .env file.

# --- server ---
PORT=3000
# NODE_ENV=production      # production requires JWT_SECRET + ADMIN_EMAIL/ADMIN_PASSWORD
APP_URL=http://localhost:3000

# --- database (SQLite file) ---
DATABASE_FILE=data/nexus.db

# --- admission rules ---
PROGRAM_CAPACITY=50        # default max students per program
ADMISSION_YEAR=2026        # used in registration numbers NX-2026-000001
REGISTRATION_OPEN=true

# --- auth (use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
TOKEN_TTL_SECONDS=28800

# --- admin account (created on first start if it does not exist) ---
ADMIN_EMAIL=admin@nexus.ac.id
ADMIN_PASSWORD=Admin#2026
ADMIN_NAME=Nexus Administrator

# --- demo tools: dummy applicants, demo account, RESET DEMO DATA button (default: on in dev, off in production)
DEMO_MODE=true

# --- email notification: none | resend | smtp ---
EMAIL_PROVIDER=none
EMAIL_FROM="NEXUS ADMISSION <no-reply@yourdomain.com>"
# Resend (https://resend.com)
RESEND_API_KEY=
# SMTP via Nodemailer (run: npm install nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
